# Backend environment configuration
APP_NAME=Invitation Understanding API
VERSION=1.0.0

# Model toggles (set to false to skip heavy models)
USE_DOCLAYOUT=true
USE_LAYOUTLM=true
USE_OCR_PPOCR=true
USE_SBERT=true

# Confidence thresholds
QUALITY_THRESHOLD=0.75
MIN_LAYOUT_CONFIDENCE=0.35

# Upload limits
MAX_UPLOAD_MB=20

# Google Calendar API key for mobile calendar integration
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here

# Google OAuth2 client credentials for user calendar access
# Set these in your actual .env file (never commit real secrets)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/v1/calendar/oauth-callback
FRONTEND_REDIRECT_URL=https://your-domain.com/calendar-auth-complete

